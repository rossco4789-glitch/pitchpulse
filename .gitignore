# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Claude Code internals (project skills are tracked governance)
.claude/*
!.claude/skills/
!.claude/settings.json

# Eval loop: run history stays local; frozen cases + digest are tracked
data/evals/ledger.jsonl

# Large binary / generated outputs (do not commit)
data/clips/
data/raw/veo/
data/processed/plots/
data/archive/

# Generated reports & dossiers (rebuilt each matchday)
data/processed/tivvy_tactical_dossier.html
reports/dossier_*.md

# Ignore generated dossiers, track raw inputs
data/scouting/*_dossier.json
!data/scouting/sources/
# Scout fetcher: raw page cache and evidence JSON hold third-party text — keep local
data/scouting/cache/
data/scouting/evidence/

# Scouting raw binaries & generated output
data/scouting/sources/**/*.docx
data/scouting/sources/**/*.doc
data/scouting/sources/**/*.pdf
data/processed/*_scouting.html
data/scouting/sources/**/brief_auto.md

# Cloud vision runner: staged payloads and remote job state stay local
data/scouting/cloud_staging/
data/scouting/sources/**/vision_job.json

# Sample data & ledger (committed for demo; swap for real data)
# data/samples/2026-09-05_st_blazey/  ← keep tracked (moved out of data/raw so
#   reconcile's tivvy_events_*.json glob and match_context.json never load demo data live;
#   its match_ledger.json sample run lives there too)
